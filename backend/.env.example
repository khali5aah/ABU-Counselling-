# Development-only example. Generate a secret and use real credentials in deployment.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=crownbird
DB_USER=crownbird
DB_PASSWORD=crownbird
DB_HOST=localhost
DB_PORT=5433
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
THROTTLE_REGISTRATION=10/minute
THROTTLE_OTP_REQUEST=10/minute
THROTTLE_OTP_VERIFY=10/minute
THROTTLE_PASSWORD_RESET_REQUEST=10/minute
THROTTLE_PASSWORD_RESET_VERIFY=10/minute
THROTTLE_SETUP=10/minute
THROTTLE_LOGIN=10/minute
OTP_PROVIDER=console
# Synthetic demo only; requires DJANGO_DEBUG=false and OTP_PROVIDER=demo.
DEMO_SIGNUP_CODES_ENABLED=false
OTP_DEV_CODE=123456
OTP_DEV_TEST_PHONES=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_PHONE_PER_HOUR=10
SETUP_TOKEN_TTL_SECONDS=900
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com/api/sms/send
TERMII_CHANNEL=dnd
